# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resource_reservation?schema=public"

# Session signing secret. Must be at least 32 characters.
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public base URL used in emails. Optional in local development.
APP_URL="http://localhost:3000"

# SMTP is required before an admin can create member accounts,
# and before password-reset or booking emails can be sent.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="mailer@example.com"
SMTP_PASS="replace-me"
SMTP_FROM="Ruhunu ResourceHub <mailer@example.com>"

# Used only by scripts/create-admin.ts. Do not commit real values.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-12-or-more-characters"
