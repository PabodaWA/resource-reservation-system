
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}


model User {
  id                    String        @id @default(cuid())
  name                  String
  email                 String        @unique
  passwordHash          String?
  role                  UserRole      @default(MEMBER)
  isActive              Boolean       @default(true)
  mustChangePassword    Boolean       @default(true)
  failedLoginAttempts   Int           @default(0)
  lockedUntil           DateTime?
  passwordResetOtpHash  String?
  passwordResetOtpExpiry DateTime?
  passwordResetAttempts Int           @default(0)
  reservations          Reservation[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}


model Resource {
  id           String        @id @default(cuid())
  name         String
  type         String
  location     String
  capacity     Int           @default(1)
  description  String?
  status       ResourceStatus @default(ACTIVE)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Reservation {
  id         String            @id @default(cuid())
  title      String
  purpose    String?
  startTime  DateTime
  endTime    DateTime
  status     ReservationStatus @default(CONFIRMED)
  userId     String
  resourceId String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource     Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  participants ReservationParticipant[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId])
  @@index([resourceId, startTime, endTime])
}

model ReservationParticipant {
  id            String      @id @default(cuid())
  name          String
  email         String
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}
